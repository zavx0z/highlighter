{
  "name": "@zavx0z/highlighter",
  "version": "0.1.0",
  "description": "Dependency-free syntax tokenizers for browser, Node.js, and Bun projects.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "bun test src",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "bun run test && bun run typecheck && bun run build",
    "prepack": "bun run check"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "syntax",
    "tokenizer",
    "highlighting",
    "typescript",
    "markdown",
    "sql"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zavx0z/highlighter.git"
  }
}
